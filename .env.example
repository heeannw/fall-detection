# woori_link base URL; do not include /api/alerts/fall
FALL_ALERT_SPRING_URL=https://your-spring-server.example.com
FALL_SENIOR_ID=53
FALL_ALERT_API_KEY=
FALL_ALERT_COOLDOWN_SEC=30
FALL_ALERT_TIMEOUT_SEC=5

# Hugging Face read token used by FastRTC's free TURN relay on Spaces
HF_TOKEN=hf_your_read_token

# Free CPU defaults
FALL_PROCESS_EVERY_N_FRAMES=3
FALL_INPUT_SIZE=480
FALL_XGBOOST_THR=0.70
FALL_CONFIRM_FRAMES=3
FALL_SESSION_TIME_LIMIT_SEC=900

# Large and slow on free CPU
FALL_ENABLE_VIDEOMAE=false
FALL_YOLO_MODEL=runs/detect/fall_detection_v3/weights/best.pt
